{
  "manifestVersion": 2,
  "id": "video-wallpaper-studio",
  "name": "Video Wallpaper",
  "version": "0.3.0",
  "description": "Pick a local or online video as Orca's background, switch between saved videos and tune side panel and center transparency.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "video-wallpaper-studio",
        "title": "Video Wallpaper",
        "icon": "play",
        "entry": "panel/index.html"
      }
    ]
  },
  "capabilities": []
}
